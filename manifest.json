{
  "manifest_version": 3,
  "name": "Fenwick Recorder",
  "version": "1.1.0",
  "description": "Record tab audio, mic, or both locally. 10 free recordings monthly; Lifetime unlocks unlimited.",
  "permissions": [
    "tabCapture",
    "storage",
    "downloads",
    "offscreen",
    "notifications",
    "tabs",
    "identity"
  ],
  "host_permissions": [
    "https://*.supabase.co/*",
    "https://accounts.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "oauth2": {
    "client_id": "492069013012-pc3briped6bnbq3q4t7rf65j2rajv6rp.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fenwick Recorder",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
